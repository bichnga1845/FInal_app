<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/change_password_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ChangePasswordActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quay lai"
            app:tint="@color/toolbar_content"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:text="Đổi mật khẩu"
            android:textColor="@color/toolbar_content"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_menu_password"
                android:contentDescription="lock"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Đặt mật khẩu mới"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Mật khẩu mới ít nhất 6 ký tự để đảm bảo an toàn"
                android:textColor="@color/text_description"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"/>

            <!-- ===== Mat khau hien tai ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Mật khẩu hiện tại"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_current_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập mật khẩu hiện tại"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="password"/>

            <!-- ===== Mat khau moi ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mật khẩu mới"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập mật khẩu mới (≥ 6 ký tự)"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="newPassword"/>

            <!-- ===== Xac nhan ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Xác nhận mật khẩu mới"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập lại mật khẩu mới"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="newPassword"/>

            <!-- Nut Doi mat khau -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_password"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="32dp"
                android:text="Đổi mật khẩu"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_password"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="@dimen/button_radius"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
