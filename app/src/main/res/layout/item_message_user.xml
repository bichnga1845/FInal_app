<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="2dp">

    <!-- Hàng: bubble + avatar cùng cấp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">

        <!-- Spacer bên trái để bubble không chiếm full width -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_user"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_button"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:maxWidth="230dp"
            android:layout_marginEnd="6dp"/>

        <!-- Avatar: INVISIBLE giữ chỗ khi không hiện -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:cardCornerRadius="17dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:visibility="invisible">
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_logo"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Thời gian: chỉ hiện ở tin cuối nhóm, căn phải (tính luôn 34dp avatar) -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_description"
        android:textSize="10sp"
        android:visibility="gone"/>

</LinearLayout>
