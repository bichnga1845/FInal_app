<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm địa chỉ mới"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"/>

        <!-- Ten nguoi nhan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tên người nhận *"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"/>

        <EditText
            android:id="@+id/et_dlg_receiver"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="VD: Nguyễn Văn A"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/placeholder"
            android:textSize="15sp"
            android:autofillHints="name"/>

        <!-- SDT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Số điện thoại *"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"/>

        <EditText
            android:id="@+id/et_dlg_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="VD: 0901234567"
            android:inputType="phone"
            android:maxLength="11"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/placeholder"
            android:textSize="15sp"
            android:autofillHints="phone"/>

        <!-- Dia chi chi tiet -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Địa chỉ chi tiết *"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"/>

        <EditText
            android:id="@+id/et_dlg_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/input_height"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="Số nhà, đường, phường/xã, quận/huyện, tỉnh/TP"
            android:inputType="textPostalAddress|textCapSentences|textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/placeholder"
            android:textSize="15sp"
            android:autofillHints="postalAddress"/>

        <!-- Dat lam mac dinh -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_set_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đặt làm địa chỉ mặc định"
            android:textColor="@color/text_main"
            android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
