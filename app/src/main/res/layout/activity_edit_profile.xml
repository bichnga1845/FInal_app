<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".EditProfileActivity">

    <!-- ===== Header: nut back trai + tieu de giua ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quay lai"
            app:tint="@color/toolbar_content"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="40dp"
            android:text="Chỉnh sửa hồ sơ"
            android:textColor="@color/toolbar_content"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar (chi xem, chua cho doi anh) -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="Anh dai dien"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Ảnh đại diện"
                android:textColor="@color/text_description"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"/>

            <!-- ===== Ho va ten ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Họ và tên"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_edit_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập họ và tên"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="name"/>

            <!-- ===== Email (read-only, vi email gan voi tai khoan Auth) ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Email (không sửa được)"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:enabled="false"
                android:focusable="false"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_description"
                android:textSize="16sp"
                android:autofillHints="emailAddress"/>

            <!-- ===== So dien thoai ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Số điện thoại"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_edit_phone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:maxLength="11"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="phone"/>

            <!-- ===== Dia chi ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Địa chỉ"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"/>

            <EditText
                android:id="@+id/et_edit_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Nhập địa chỉ chi tiết"
                android:inputType="textPostalAddress|textCapSentences|textMultiLine"
                android:maxLines="3"
                android:padding="12dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp"
                android:autofillHints="postalAddress"/>

            <!-- ===== Nut Luu ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="32dp"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"/>

            <!-- ===== Nut Huy ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_edit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="@dimen/button_radius"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
